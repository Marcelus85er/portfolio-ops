---
// src/pages/api.astro
import Layout from '../layouts/Layout.astro';

let apiData = null;

try {
    const STRAPI_URL = import.meta.env.STRAPI_URL || 'http://localhost:1337';
    const response = await fetch(`${STRAPI_URL}/api/api-portal?populate=*`);
    
    if (response.ok) {
        const json = await response.json();
        apiData = json?.data?.attributes || json?.data || null;
    }
} catch (error) {
    console.warn("Strapi API portal fetch skipped/failed:", error);
}

const title = apiData?.title || "Developer API Portal";
const description = apiData?.description || "Secure access to infrastructure metrics, headless CMS data, and automated webhooks. Authenticate via Keycloak to manage your access tokens and API keys.";
---

<Layout title="API Portal | Marcel Avila">
    <div class="pt-16 pb-24 max-w-4xl mx-auto px-4 sm:px-6">
        
        <!-- Header Section -->
        <div class="text-center mb-12">
            <!-- Secured Badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-sm font-semibold mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
                OIDC Edge Secured
            </div>
            
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-6 tracking-tight">{title}</h1>
            <p class="text-lg text-slate-400 leading-relaxed max-w-2xl mx-auto">{description}</p>
        </div>
        
        <!-- Authenticated Dashboard UI (Visible because Ingress let them through) -->
        <div class="bg-slate-800/80 border border-slate-700 rounded-2xl p-8 shadow-xl">
            <div class="flex justify-between items-center mb-8 border-b border-slate-700 pb-4">
                <h2 class="text-2xl font-bold text-white">Your Access Keys</h2>
                <span class="text-sm text-slate-400 font-mono">Status: Authenticated</span>
            </div>
            
            <div class="space-y-6">
                <!-- Mock API Key Row -->
                <div class="bg-[#1a2035] border border-slate-700/50 rounded-lg p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h3 class="text-white font-bold mb-1">Production Read-Only Token</h3>
                        <p class="text-sm text-slate-400">Grants access to GET routes on Strapi and infrastructure metrics.</p>
                    </div>
                    <button class="bg-slate-700 hover:bg-slate-600 text-white text-sm font-bold py-2 px-4 rounded transition-colors" onclick="alert('Token generation coming in V2!')">
                        Generate Token
                    </button>
                </div>

                <!-- Mock Webhook Row -->
                <div class="bg-[#1a2035] border border-slate-700/50 rounded-lg p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <div>
                        <h3 class="text-white font-bold mb-1">Trigger CI/CD Webhook</h3>
                        <p class="text-sm text-slate-400">Authenticate payloads to ArgoCD or GitHub Actions.</p>
                    </div>
                    <button class="bg-slate-700 hover:bg-slate-600 text-white text-sm font-bold py-2 px-4 rounded transition-colors" onclick="alert('Webhook management coming in V2!')">
                        Configure
                    </button>
                </div>
            </div>
        </div>

    </div>
</Layout>