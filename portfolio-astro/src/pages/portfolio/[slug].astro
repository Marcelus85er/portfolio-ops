---
// src/pages/portfolio/[slug].astro
import Layout from '../../layouts/Layout.astro';
import JSONLD from '../../components/JSONLD.astro';
import { marked } from 'marked'; 

export async function getStaticPaths() {
    const STRAPI_URL = import.meta.env.STRAPI_URL || 'http://localhost:1337';

    try {
        // Changed to populate=* to fetch author, publisher, tags, and coverImage
        const response = await fetch(`${STRAPI_URL}/api/portfolios?populate=*`);
        if (!response.ok) return [];

        const { data } = await response.json();
        const projects = data || [];

        return projects.map((item: any) => ({
            params: { slug: item.slug }, 
            props: { project: item },      
        }));
    } catch (error) {
        console.error("Failed to fetch portfolio projects for static paths:", error);
        return [];
    }
}

const { project } = Astro.props;
---

<Layout title={`${project?.title || 'Case Study'} | Marcel.ops`}>
    
    <!-- Injects the Schema.org JSON directly into the DOM -->
    <JSONLD 
        schemaType="CreativeWork"
        title={project.title}
        excerpt={project.excerpt}
        coverImage={project.coverImage}
        publishDate={project.publishDate || project.publishedAt}
        author={project.author}
        publisher={project.publisher}
        tags={project.tags}
    />

    <article class="max-w-4xl mx-auto py-12 px-4">
        <header class="mb-10 pb-6 border-b border-slate-800">
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight leading-tight">
                {project.title}
            </h1>
            
            <div class="flex flex-wrap items-center gap-4 text-sm font-mono text-slate-400 mt-4">
                <span class="bg-sky-500/10 border border-sky-500/30 px-3 py-1 rounded-md text-sky-400 font-medium">
                    Infrastructure Case Study
                </span>
                <!-- Updated to prioritize your new custom publishDate field -->
                <span>Published: {new Date(project.publishDate || project.publishedAt).toLocaleDateString()}</span>
            </div>
        </header>

        <!-- Tailwind Typography Processor -->
        <div class="prose prose-invert prose-sky max-w-none text-slate-300">
            
            {project.blocks && project.blocks.length > 0 ? (
                await Promise.all(project.blocks.map(async (block: any) => {
                    
                    if (block.__component && block.__component.toLowerCase().includes('body')) {
                        const rawMarkdown = block.content || '';
                        const parsedHTML = await marked.parse(rawMarkdown);
                        return <div set:html={parsedHTML} class="mb-6" />;
                    }
                    
                    return null;
                }))
            ) : (
                <p class="text-slate-500 italic">This case study does not contain any content blocks yet.</p>
            )}

        </div>
    </article>

</Layout>