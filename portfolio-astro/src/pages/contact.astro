---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';

let contactData = null;

try {
    const STRAPI_URL = import.meta.env.STRAPI_URL || 'http://localhost:1337';
    const response = await fetch(`${STRAPI_URL}/api/contact?populate=*`);
    
    if (response.ok) {
        const json = await response.json();
        contactData = json?.data?.attributes || json?.data || null;
    } else {
        console.error(`Strapi Contact Fetch Failed: ${response.status} ${response.statusText}`);
    }
} catch (error) {
    console.warn("Strapi contact page fetch skipped/failed:", error);
}

const title = contactData?.title || "Get in Touch";
const description = contactData?.description || "Have an idea or project you want to collaborate on? Drop a message below.";
---

<Layout title="Contact | Marcel Avila">
    <div class="pt-16 pb-24 max-w-2xl mx-auto px-4">
        
        <!-- Header Section -->
        <div class="text-center mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-4 tracking-tight">{title}</h1>
            <p class="text-lg text-slate-400">{description}</p>
        </div>
        
        <!-- Contact Form Placeholder -->
        <form class="space-y-6" onsubmit="event.preventDefault(); alert('Form submission coming in V2!');">
            
            <!-- Name Field -->
            <div>
                <label for="name" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Name</label>
                <input 
                    type="text" 
                    id="name" 
                    name="name" 
                    class="w-full bg-[#1a2035] border border-slate-700/50 rounded-lg p-3.5 text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-all shadow-inner"
                    required
                />
            </div>
            
            <!-- Email Field -->
            <div>
                <label for="email" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full bg-[#1a2035] border border-slate-700/50 rounded-lg p-3.5 text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-all shadow-inner"
                    required
                />
            </div>
            
            <!-- Message Field -->
            <div>
                <label for="message" class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Message</label>
                <textarea 
                    id="message" 
                    name="message" 
                    rows="6" 
                    class="w-full bg-[#1a2035] border border-slate-700/50 rounded-lg p-3.5 text-white focus:border-sky-500 focus:ring-1 focus:ring-sky-500 outline-none transition-all shadow-inner resize-y"
                    required
                ></textarea>
            </div>
            
            <!-- Submit Button -->
            <button 
                type="submit" 
                class="w-full bg-[#0ea5e9] hover:bg-[#0284c7] text-white font-bold py-4 px-6 rounded-lg transition-colors shadow-lg shadow-sky-900/20 mt-4 text-lg tracking-wide"
            >
                Send Message
            </button>
            
        </form>
    </div>
</Layout>