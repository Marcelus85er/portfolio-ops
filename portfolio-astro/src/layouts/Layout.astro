---
// Import the newly updated BaseHead component
import BaseHead from '../components/BaseHead.astro';

// We removed the duplicate global.css import here since BaseHead already handles it.

// Explicitly define the props we expect to receive from our pages
interface Props {
    title?: string;
    description?: string;
    image?: string;
}

const { 
    title = "Marcel.ops | Cloud Engineer",
    // Provide a solid fallback description for pages that don't pass one
    description = "Building resilient, cloud-native infrastructure and AI-driven automation.",
    image 
} = Astro.props;

// Fallback navigation in case Strapi is unreachable
let menuItems = [
    { label: 'About', URL: '/about' },
    { label: 'Portfolio', URL: '/portfolio' },
    { label: 'White Papers', URL: '/white-papers' }
];

let footerLinks = [];

try {
    const STRAPI_URL = import.meta.env.STRAPI_URL || 'http://localhost:1337';
    
    // Fetch Main Navigation
    const navResponse = await fetch(`${STRAPI_URL}/api/main-navigation?populate=*`);
    if (navResponse.ok) {
        const { data } = await navResponse.json();
        if (data?.Menu) {
            menuItems = data.Menu;
        }
    }

    // Fetch Footer Navigation
    const footerResponse = await fetch(`${STRAPI_URL}/api/footer-navigation?populate=footerMenu`);
    if (footerResponse.ok) {
        const json = await footerResponse.json();
        const data = json?.data?.attributes || json?.data || {};
        footerLinks = data?.footerMenu || [];
    }
} catch (error) {
    console.warn("Strapi navigation fetch skipped/failed:", error);
}
---

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- 
      Inject BaseHead here! It will automatically generate your Title, 
      Meta Description, Canonical URLs, and OpenGraph/Twitter Cards 
    -->
    <BaseHead title={title} description={description} image={image} />
</head>
<body class="bg-slate-950 text-slate-200 min-h-screen flex flex-col font-sans">
    
    <!-- Global Navigation -->
    <nav class="border-b border-slate-800 bg-slate-950 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 h-20 flex items-center justify-between">
            <div class="font-bold text-2xl text-white">
                <a href="/">Marcel<span class="text-blue-500">.ops</span></a>
            </div>
            
            <!-- Dynamic Link Generation -->
            <div class="flex space-x-8 text-sm font-medium">
                {menuItems.map((item: any) => (
                    <a href={item.URL} class="text-slate-300 hover:text-white transition-colors">
                        {item.label}
                    </a>
                ))}
            </div>
            
        </div>
    </nav>

    <!-- Main Content -->
    <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-12">
        <slot />
    </main>

    <!-- Global Footer -->
    <footer class="border-t border-slate-800 py-8 mt-auto">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4 text-slate-500 text-sm">
            <p>&copy; {new Date().getFullYear()} Marcel. Cloud Infrastructure & DevOps Portfolio.</p>
            
            <!-- Dynamic Footer Links -->
            {footerLinks.length > 0 && (
                <ul class="flex gap-6 font-medium">
                    {footerLinks.map((link: any) => (
                        <li>
                            <a 
                                href={link.URL} 
                                class="hover:text-blue-400 transition-colors"
                            >
                                {link.label}
                            </a>
                        </li>
                    ))}
                </ul>
            )}
        </div>
    </footer>

</body>
</html>